export using ::SDL_GDKSuspendComplete;

// The SDL_FORCE_INLINE API (16), adapted (src/inline.cpp).
export namespace mcpplibs::mwrap::sdl3 {
#undef SDL_size_mul_check_overflow
bool SDL_size_mul_check_overflow(size_t a, size_t b, size_t *ret);
#undef SDL_size_add_check_overflow
bool SDL_size_add_check_overflow(size_t a, size_t b, size_t *ret);
#undef SDL_Swap16
Uint16 SDL_Swap16(Uint16 x);
#undef SDL_Swap32
Uint32 SDL_Swap32(Uint32 x);
#undef SDL_Swap64
Uint64 SDL_Swap64(Uint64 x);
#undef SDL_SwapFloat
float SDL_SwapFloat(float x);
#undef SDL_MostSignificantBitIndex32
int SDL_MostSignificantBitIndex32(Uint32 x);
#undef SDL_HasExactlyOneBitSet32
bool SDL_HasExactlyOneBitSet32(Uint32 x);
#undef SDL_RectToFRect
void SDL_RectToFRect(const SDL_Rect *rect, SDL_FRect *frect);
#undef SDL_PointInRect
bool SDL_PointInRect(const SDL_Point *p, const SDL_Rect *r);
#undef SDL_RectEmpty
bool SDL_RectEmpty(const SDL_Rect *r);
#undef SDL_RectsEqual
bool SDL_RectsEqual(const SDL_Rect *a, const SDL_Rect *b);
#undef SDL_PointInRectFloat
bool SDL_PointInRectFloat(const SDL_FPoint *p, const SDL_FRect *r);
#undef SDL_RectEmptyFloat
bool SDL_RectEmptyFloat(const SDL_FRect *r);
#undef SDL_RectsEqualEpsilon
bool SDL_RectsEqualEpsilon(const SDL_FRect *a, const SDL_FRect *b, float epsilon);
#undef SDL_RectsEqualFloat
bool SDL_RectsEqualFloat(const SDL_FRect *a, const SDL_FRect *b);
}  // namespace mcpplibs::mwrap::sdl3
