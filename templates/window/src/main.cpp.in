// {{project.name}} — a sketch pad: draw with the mouse, C clears the page, S
// saves it as sketch.bmp, Esc or closing the window quits.
//
// SDL runs the program through its app callbacks: <SDL3/SDL_main.h>, included
// here with SDL_MAIN_USE_CALLBACKS in the one file that defines the entry
// points, supplies main and calls SDL_AppInit, SDL_AppEvent, SDL_AppIterate
// and SDL_AppQuit. Everything else comes from import mcpplibs.mwrap.sdl3.
#define SDL_MAIN_USE_CALLBACKS 1
#include <SDL3/SDL_main.h>

import std;
import mcpplibs.mwrap.sdl3;

using namespace mcpplibs::mwrap::sdl3::macros;  // SDL_INIT_VIDEO, SDLK_*, SDL_BUTTON_LMASK …

namespace {

struct Pad {
    SDL_Window* window = nullptr;
    SDL_Renderer* renderer = nullptr;
    SDL_Texture* page = nullptr;  // the drawing, kept across frames
    std::optional<SDL_FPoint> last;
    float hue = 0;
};

void clear(Pad& pad) {
    SDL_SetRenderTarget(pad.renderer, pad.page);
    SDL_SetRenderDrawColor(pad.renderer, 250, 248, 240, SDL_ALPHA_OPAQUE);
    SDL_RenderClear(pad.renderer);
    SDL_SetRenderTarget(pad.renderer, nullptr);
}

void stroke(Pad& pad, SDL_FPoint to) {
    const SDL_FPoint from = pad.last.value_or(to);
    pad.hue = std::fmod(pad.hue + 0.75f, 360.0f);
    const float h = pad.hue / 60.0f, x = 1 - std::fabs(std::fmod(h, 2.0f) - 1);
    const std::array<float, 3> rgb = h < 1 ? std::array{1.f, x, 0.f} : h < 2 ? std::array{x, 1.f, 0.f}
                                   : h < 3 ? std::array{0.f, 1.f, x}  : h < 4 ? std::array{0.f, x, 1.f}
                                   : h < 5 ? std::array{x, 0.f, 1.f}  : std::array{1.f, 0.f, x};
    SDL_SetRenderTarget(pad.renderer, pad.page);
    SDL_SetRenderDrawColorFloat(pad.renderer, rgb[0] * 0.8f, rgb[1] * 0.8f, rgb[2] * 0.8f, 1.0f);
    for (int dy = -2; dy <= 2; ++dy)  // a 5-pixel pen
        for (int dx = -2; dx <= 2; ++dx)
            if (dx * dx + dy * dy <= 5) SDL_RenderLine(pad.renderer, from.x + dx, from.y + dy, to.x + dx, to.y + dy);
    SDL_SetRenderTarget(pad.renderer, nullptr);
    pad.last = to;
}

void save(Pad& pad) {
    SDL_SetRenderTarget(pad.renderer, pad.page);
    SDL_Surface* shot = SDL_RenderReadPixels(pad.renderer, nullptr);
    SDL_SetRenderTarget(pad.renderer, nullptr);
    if (shot && SDL_SaveBMP(shot, "sketch.bmp")) SDL_Log("saved sketch.bmp (%dx%d)", shot->w, shot->h);
    else SDL_Log("could not save: %s", SDL_GetError());
    SDL_DestroySurface(shot);
}

}  // namespace

SDL_AppResult SDL_AppInit(void** appstate, int, char*[]) {
    SDL_SetAppMetadata("{{project.name}}", "0.1.0", nullptr);
    if (!SDL_Init(SDL_INIT_VIDEO)) {
        SDL_Log("SDL_Init: %s", SDL_GetError());
        return SDL_APP_FAILURE;
    }
    auto* pad = new Pad;
    *appstate = pad;
    if (!SDL_CreateWindowAndRenderer("{{project.name}} — draw; C clears, S saves, Esc quits", 800, 600,
                                     SDL_WINDOW_HIGH_PIXEL_DENSITY, &pad->window, &pad->renderer)) {
        SDL_Log("SDL_CreateWindowAndRenderer: %s", SDL_GetError());
        return SDL_APP_FAILURE;
    }
    SDL_SetRenderVSync(pad->renderer, 1);
    SDL_SetRenderLogicalPresentation(pad->renderer, 800, 600, SDL_LOGICAL_PRESENTATION_LETTERBOX);
    pad->page = SDL_CreateTexture(pad->renderer, SDL_PIXELFORMAT_RGBA32, SDL_TEXTUREACCESS_TARGET, 800, 600);
    if (!pad->page) {
        SDL_Log("SDL_CreateTexture: %s", SDL_GetError());
        return SDL_APP_FAILURE;
    }
    clear(*pad);
    return SDL_APP_CONTINUE;
}

SDL_AppResult SDL_AppEvent(void* appstate, SDL_Event* event) {
    auto& pad = *static_cast<Pad*>(appstate);
    SDL_ConvertEventToRenderCoordinates(pad.renderer, event);
    switch (event->type) {
    case SDL_EVENT_QUIT: return SDL_APP_SUCCESS;
    case SDL_EVENT_KEY_DOWN:
        if (event->key.key == SDLK_ESCAPE) return SDL_APP_SUCCESS;
        if (event->key.key == SDLK_C) clear(pad);
        if (event->key.key == SDLK_S) save(pad);
        break;
    case SDL_EVENT_MOUSE_BUTTON_DOWN:
        pad.last.reset();
        stroke(pad, {event->button.x, event->button.y});
        break;
    case SDL_EVENT_MOUSE_MOTION:
        if (event->motion.state & SDL_BUTTON_LMASK) stroke(pad, {event->motion.x, event->motion.y});
        break;
    default: break;
    }
    return SDL_APP_CONTINUE;
}

SDL_AppResult SDL_AppIterate(void* appstate) {
    auto& pad = *static_cast<Pad*>(appstate);
    SDL_SetRenderDrawColor(pad.renderer, 40, 40, 48, SDL_ALPHA_OPAQUE);
    SDL_RenderClear(pad.renderer);
    SDL_RenderTexture(pad.renderer, pad.page, nullptr, nullptr);
    SDL_RenderPresent(pad.renderer);
    return SDL_APP_CONTINUE;
}

void SDL_AppQuit(void* appstate, SDL_AppResult) {
    auto* pad = static_cast<Pad*>(appstate);
    if (!pad) return;
    SDL_DestroyTexture(pad->page);
    SDL_DestroyRenderer(pad->renderer);
    SDL_DestroyWindow(pad->window);
    delete pad;
}
